generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  role          String   @default("admin")
  events        Event[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteSettings {
  id           Int      @id @default(1)
  appNameFirstPart String?
  appNameSecondPart String?
  faviconUrl   String?
  convenerTitle String?
  convenerLogo1Url String?
  convenerLogo2Url String?
  heroBadgeText String?  @db.Text
  heroText     String   @db.Text
  heroSubText  String   @db.Text
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  address      String?  @db.Text
  eventFee     Float    @default(0)
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPass     String?
  emailEnabled Boolean  @default(false)

  // Landing Page Dynamics
  headerPatronageText String?  @db.Text
  headerPresidentText String?  @db.Text
  headerLocationText  String?  @db.Text
  headerLocationSubText String? @db.Text
  headerDateText      String?
  heroSliderImages    String?  @db.Text
  transformationHubTitle String? @db.Text
  transformationHubDescription String? @db.Text
  partnerNames        String?  @db.Text
  infoBarDateText String?
  infoBarLocationText String?
  infoBarThemeText String?

  transformationHubFeature1Title String?
  transformationHubFeature1Desc  String? @db.Text
  transformationHubFeature2Title String?
  transformationHubFeature2Desc  String? @db.Text
  transformationHubFeature3Title String?
  transformationHubFeature3Desc  String? @db.Text
  transformationHubFeature4Title String?
  transformationHubFeature4Desc  String? @db.Text

  scheduleTitle       String?
  scheduleDescription String? @db.Text
  
  whyAttendTitle      String?
  whyAttendSubtitle   String? @db.Text
  whyAttendCard1Title String?
  whyAttendCard1Desc  String? @db.Text
  whyAttendCard1ImgUrl String? @db.Text
  whyAttendCard2Title String?
  whyAttendCard2Desc  String? @db.Text
  whyAttendCard2ImgUrl String? @db.Text
  whyAttendCard3Title String?
  whyAttendCard3Desc  String? @db.Text
  whyAttendCard3ImgUrl String? @db.Text
  scheduleDaysCount   Int?  @default(4)
  scheduleDates       Json?

  confGuideTitle             String?
  confGuideSubtitle          String? @db.Text
  confGuideTrack1Title       String?
  confGuideTrack1Subtitle    String? @db.Text
  confGuideTrack1Date        String?
  confGuideTrack1EventTitle  String?
  confGuideTrack1EventDesc   String? @db.Text
  confGuideTrack2Title       String?
  confGuideTrack2Subtitle    String? @db.Text
  confGuideTrack2Date        String?
  confGuideTrack2EventTitle  String?
  confGuideTrack2EventDesc   String? @db.Text
  confGuideTrack3Title       String?
  confGuideTrack3Subtitle    String? @db.Text
  confGuideTrack3Date        String?
  confGuideTrack3EventTitle  String?
  confGuideTrack3EventDesc   String? @db.Text

  featuredSpeakersTitle      String?
  featuredSpeakersSubtitle   String? @db.Text
  featuredSpeakersCount      Int?  @default(4)
  featuredSpeakers           Json?

  ourApproachTitle           String?
  ourApproachCard1Title      String?
  ourApproachCard1Desc       String? @db.Text
  ourApproachCard1ImgUrl     String? @db.Text
  ourApproachCard2Title      String?
  ourApproachCard2Desc       String? @db.Text
  ourApproachCard2ImgUrl     String? @db.Text
  ourApproachCard3Title      String?
  ourApproachCard3Desc       String? @db.Text
  ourApproachCard3ImgUrl     String? @db.Text

  aboutHeroBadgeText         String?
  aboutHeroTitle             String?
  aboutHeroSubtitle          String? @db.Text
  aboutHeroImgUrl            String? @db.Text

  aboutMissionTitle          String?
  aboutMissionSubtitle       String? @db.Text
  aboutMissionCardTitle      String?
  aboutMissionCardDesc       String? @db.Text
  aboutVisionCardTitle       String?
  aboutVisionCardDesc        String? @db.Text

  aboutVenuesTitle           String?
  aboutVenuesSubtitle        String? @db.Text
  aboutVenuesCount           Int?    @default(2)
  aboutVenues                Json?
  aboutVenuesWarningText     String? @db.Text

  aboutWorkshopText              String? @db.Text
  aboutTargetParticipantsText    String? @db.Text
  aboutWhySponsorText            String? @db.Text
  aboutSponsorshipPackagesText   String? @db.Text
  aboutBrandingOpportunitiesText String? @db.Text
  aboutExpectedOutcomesText      String? @db.Text
  aboutPartnerWithUsText         String? @db.Text

  aboutCtaTitle              String?
  aboutCtaSubtitle           String? @db.Text

  agendaHeroTitle            String?
  agendaHeroSubtitle         String? @db.Text
  agendaHeroDesc             String? @db.Text
  agendaHeroImgUrl           String? @db.Text
  agendaSectionTitle         String?
  agendaSectionSubtitle      String? @db.Text
  agendaDaysCount            Int?    @default(4)
  agendaDays                 Json?
  agendaBrochureUrl          String? @db.Text

  sponsorshipHeroTagline String?
  sponsorshipHeroTitle   String?
  sponsorshipHeroDesc    String? @db.Text

  sponsorshipPartnersTitle String?
  sponsorshipPartnersDesc  String? @db.Text
  sponsorshipPartners      Json?

  sponsorshipPackagesTitle String?
  sponsorshipPackagesDesc  String? @db.Text
  sponsorshipPackages      Json?

  sponsorshipCtaTitle      String?
  sponsorshipCtaDesc       String? @db.Text

  contactPageTagline       String?
  contactPageTitle         String?
  contactPageDesc          String? @db.Text

  updatedAt    DateTime @updatedAt
}

model ScheduleItem {
  id          String   @id @default(uuid())
  day         Int
  timeRange   String
  title       String
  location    String?
  speaker     String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  subject   String
  message   String   @db.Text
  sentAt    DateTime @default(now())
}

model GalleryImage {
  id        String   @id @default(uuid())
  url       String   @db.Text
  caption   String?  @db.Text
  createdAt DateTime @default(now())
}

model Event {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  description     String   @db.Text
  content         String?  @db.Text
  date            DateTime
  imageUrl        String?
  sponsorImageUrl String?
  type            String   @default("workshop")
  location        String?
  capacity        Int?
  status          String   @default("Draft")
  category        String?
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  applications    Application[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime      @updatedAt
}

model Application {
  id           String   @id @default(uuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fullName     String
  email        String
  phone        String
  organization String
  createdAt    DateTime @default(now())
}

model Registration {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  email           String
  phone           String
  organization    String
  jobTitle        String
  ticketType      String   
  status          String   @default("PENDING") 
  createdAt       DateTime @default(now())
}
